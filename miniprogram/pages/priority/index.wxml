<view class="page priority-page">
 <view class="card"><view class="section-title">设置筛选条件</view><view class="small">满足任一已选条件的居民都会列入结果</view><view class="filter-row"><view class="between"><view><view class="label">多病共存</view><view class="small">最新归档病历中记录的疾病种类数</view></view><switch checked="{{filters.complex}}" bindchange="toggle" data-key="complex" color="#37352f"/></view><view wx:if="{{filters.complex}}" class="row threshold"><text>疾病数量不少于</text><input value="{{filters.minChronic}}" type="number" data-key="minChronic" bindinput="input"/><text>种</text></view></view>
 <view class="filter-row between"><view><view class="label">异常指标</view><view class="small">最新病历中由医师标记需复核</view></view><switch checked="{{filters.abnormal}}" bindchange="toggle" data-key="abnormal" color="#37352f"/></view>
 <view class="filter-row"><view class="between"><view><view class="label">长期未复诊</view><view class="small">距本卫生室最近一次归档就诊的天数</view></view><switch checked="{{filters.overdue}}" bindchange="toggle" data-key="overdue" color="#37352f"/></view><view wx:if="{{filters.overdue}}" class="row threshold"><text>距最近就诊至少</text><input value="{{filters.days}}" type="number" data-key="days" bindinput="input"/><text>天</text></view></view><button class="primary" bindtap="filter" loading="{{busy}}" disabled="{{busy}}">筛选居民</button></view>
 <block wx:if="{{ran}}"><view class="between section"><text class="section-title">筛选结果 · {{rows.length}} 人</text><text bindtap="all" class="link">{{selectedCount === rows.length ? '取消全选' : '全选'}}</text></view><view class="empty" wx:if="{{!rows.length}}"><view>暂无居民符合当前条件</view><view>可调整筛选维度后重试</view></view><view wx:for="{{rows}}" wx:key="_id" class="candidate-row {{item.selected ? 'selected-row' : ''}}" bindtap="select" data-id="{{item._id}}" hover-class="block-hover"><view class="row"><view class="check {{item.selected ? 'checked' : ''}}">✓</view><view class="grow"><view class="patient-name">{{item.name}} <text class="small">{{item.age}} 岁</text></view><view class="meta">{{item.village}} · {{item.code}}</view></view><text class="badge {{item.urgency === '紧急' ? 'red' : item.urgency === '优先' ? 'warn' : ''}}">{{item.urgency}}</text></view><view class="reason" wx:for="{{item.reasons}}" wx:key="*this" wx:for-item="reason">{{reason}}</view><view class="small">最近就诊 {{item.lastVisit}}</view></view>
 <view class="card" wx:if="{{rows.length}}"><view class="section-title">确认专家接诊名单</view><view class="spacer"></view><view class="field"><view class="label">接诊名单名称</view><input value="{{title}}" data-key="title" bindinput="meta" maxlength="80"/></view><view class="field"><view class="label">计划接诊日期</view><picker mode="date" value="{{serviceDate}}" data-key="serviceDate" bindchange="meta"><view class="date-picker">{{serviceDate}}</view></picker></view><view class="notice info">已人工勾选 {{selectedCount}} 人。保存后可在“专家诊疗记录”中逐人记录专家意见。</view><button class="primary" bindtap="save" disabled="{{busy || !selectedCount || roster}}" loading="{{busy}}">{{roster ? '名单已确认保存' : '确认并保存接诊名单'}}</button><view class="spacer"></view><view class="actions"><button class="outline" bindtap="export" disabled="{{busy || !roster}}">导出 PDF 名单</button><button bindtap="outreach" disabled="{{!roster}}">录入专家意见</button></view></view></block><view class="spacer"></view><button class="outline" bindtap="outreach">查看专家接诊名单</button></view>
