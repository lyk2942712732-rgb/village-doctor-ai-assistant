.workspace-path{display:flex;align-items:center;gap:12rpx;font-size:24rpx;color:#706f6b;margin-bottom:40rpx;min-height:60rpx}.path-icon{width:30rpx;height:30rpx;opacity:.65}.clinic-link{display:flex;align-items:center;gap:10rpx;padding:12rpx 8rpx;color:#57564f}.clinic-link image{width:30rpx;height:30rpx}.book-cover{display:flex;align-items:center;gap:26rpx;padding:34rpx 28rpx;background:#eeede9;border:1rpx solid #e7e5e0;border-radius:6rpx}.book-cover image{width:100rpx;height:100rpx}.cover-title{font-size:34rpx;font-weight:600;margin-bottom:8rpx}.book-cover .small{font-size:22rpx}.welcome{padding:38rpx 0}.welcome .title{font-size:54rpx;line-height:1.4}.login-sheet{margin-bottom:18rpx}.login-alternatives{display:flex;gap:16rpx;margin-top:18rpx}.login-alternatives button{flex:1;font-size:26rpx}.document-footnote{font-size:24rpx;color:#706f6b;line-height:1.8;padding:0 4rpx}.workspace-heading{margin-bottom:30rpx}.workspace-heading .subtitle{margin-top:12rpx}.document-properties{border-top:1rpx solid #e7e5e0;border-bottom:1rpx solid #e7e5e0;padding:12rpx 0;margin-bottom:30rpx;font-size:26rpx}.document-properties>view{display:flex;gap:22rpx;padding:10rpx 0}.property-label{color:#706f6b;width:134rpx;flex-shrink:0}.new-visit{display:flex;align-items:center;gap:22rpx;padding:24rpx 20rpx;background:#eeede9;border:1rpx solid #e1dfd8;border-radius:6rpx}.new-visit-icon{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;background:#fff;border:1rpx solid #d9d6ce;border-radius:6rpx;flex-shrink:0}.new-visit-icon image{width:36rpx;height:36rpx}.new-visit .small{margin-top:4rpx;font-size:23rpx}.task-table{border-top:1rpx solid #dedcd6;border-bottom:1rpx solid #dedcd6}.table-head{display:flex;justify-content:space-between;padding:14rpx 48rpx 14rpx 6rpx;background:#efedea;color:#706f6b;font-size:23rpx}.task-row{display:flex;align-items:center;gap:18rpx;padding:22rpx 4rpx;border-top:1rpx solid #e7e5e0;min-height:94rpx}.task-row .line-icon{width:34rpx;height:34rpx;opacity:.7}.task-count{font-size:30rpx;font-weight:500;font-variant-numeric:tabular-nums;min-width:36rpx;text-align:right}.directory{border-top:1rpx solid #e7e5e0}.directory-row{display:flex;align-items:center;gap:22rpx;padding:25rpx 6rpx;border-bottom:1rpx solid #e7e5e0}.directory-title{font-size:29rpx;font-weight:500}.directory-row .small{margin-top:4rpx}.draft-sheet{border-top:1rpx solid #e7e5e0;border-bottom:1rpx solid #e7e5e0}.archive-strip{display:flex;gap:28rpx;padding:24rpx 0;color:#706f6b;font-size:24rpx}.document-footer{display:flex;justify-content:space-between;align-items:center;gap:18rpx;margin:30rpx 0}.workspace-page{padding-top:20rpx}

.local-context{flex-shrink:0;max-width:340rpx;text-align:right}.local-place{font-size:24rpx;color:#57564f;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:4rpx 0}.local-caret{padding-left:8rpx;color:#9b9a97}.local-clock{font-size:21rpx;line-height:1.6;color:#8a8985;font-variant-numeric:tabular-nums}.workspace-path>.grow{min-width:0}
