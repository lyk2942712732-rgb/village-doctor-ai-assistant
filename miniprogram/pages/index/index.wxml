<view class="page workspace-page">
 <view class="workspace-path"><image class="path-icon" src="/images/notion/notebook.png"/><text class="grow">村医病历助手</text><view wx:if="{{profile && !demo}}" class="clinic-link" bindtap="clinic" hover-class="block-hover"><image src="/images/notion/clinic.png"/><text>我的卫生室</text></view><view wx:else class="local-context"><picker mode="region" value="{{locationRegion}}" bindchange="chooseRegion"><view class="local-place">{{locationLabel || '选择所处地区'}}<text class="local-caret">⌄</text></view></picker><view class="local-clock">北京时间 {{beijingClock}}</view></view></view>
 <view wx:if="{{error}}" class="error">{{error}}</view>
 <block wx:if="{{!profile}}">
  <view class="book-cover"><image src="/images/notion/notebook.png"/><view><view class="cover-title">接诊工作簿</view><view class="small">问诊记录 / 居民档案 / 下乡台账</view></view></view>
  <view class="welcome"><view class="title">村医的日常，<view>一页页记好。</view></view><view class="subtitle">记录本次问诊，接续历次就诊。<view>病历由你填写、核实与确认。</view></view></view>
  <view class="card login-sheet"><view class="section-title">登录账号</view><view class="meta">直接使用当前微信身份登录</view><view class="spacer"></view><view class="field"><view class="label">医师姓名</view><input value="{{doctorName}}" data-key="doctorName" bindinput="input" placeholder="可选，可在登录后完善姓名" maxlength="40"/></view><view class="field"><view class="label">卫生室邀请码（可选）</view><input value="{{invite}}" data-key="invite" bindinput="input" placeholder="填写后登录时自动加入该卫生室" password maxlength="64"/></view><button class="primary" bindtap="login" loading="{{busy}}" disabled="{{busy}}">微信身份登录</button><view class="meta">不填邀请码也能登录；登录后可创建或加入多个卫生室。</view></view>
  
 </block>
 <block wx:else>
  <view wx:if="{{demo}}" class="notice">演示工作簿 · 以下为虚构资料</view>
  <view class="workspace-heading"><image class="page-symbol" src="/images/notion/notebook.png"/><view class="title">接诊工作台</view><view class="subtitle">{{profile.clinicName || '尚未选择卫生室'}}</view></view>
  <view class="document-properties"><view><text class="property-label">接诊医师</text><text>{{profile.name}}</text></view><view><text class="property-label">今日日期</text><text>{{today}}</text></view></view>
  <view wx:if="{{!profile.clinicId}}" class="card"><view class="section-title">登录成功，先选择接诊的卫生室</view><view class="subtitle">加入或创建卫生室后才能接诊。一个账号可以加入多个卫生室。</view><view class="spacer"></view><button class="primary" bindtap="clinic">加入或创建卫生室</button></view>
  <block wx:if="{{profile.clinicId}}"><view class="between"><text class="small">当前工作卫生室</text><text class="link" bindtap="clinic">管理 / 切换卫生室</text></view>
  <view class="new-visit" bindtap="navigate" data-page="record" hover-class="block-hover"><view class="new-visit-icon"><image src="/images/notion/plus.png"/></view><view class="grow"><view class="section-title">开始接诊</view><view class="small">手动记录，或逐项采用AI填写</view></view><image class="line-icon" src="/images/notion/arrow.png"/></view>
  <view class="between section"><text class="section-title">待办事项</text><text class="small">{{today}}</text></view>
  <view class="task-table"><view class="table-head"><text>工作事项</text><text>待处理</text></view><view class="task-row" bindtap="navigate" data-page="record" hover-class="block-hover"><image class="line-icon" src="/images/notion/record.png"/><text class="grow">待核对病历草稿</text><text class="task-count">{{summary.drafts.length}}</text><image class="chevron" src="/images/notion/chevron.png"/></view><view class="task-row" bindtap="navigate" data-page="residents" hover-class="block-hover"><image class="line-icon" src="/images/notion/folder.png"/><text class="grow">待导出转诊包</text><text class="task-count">{{summary.referrals}}</text><image class="chevron" src="/images/notion/chevron.png"/></view><view class="task-row" bindtap="navigate" data-page="priority" hover-class="block-hover"><image class="line-icon" src="/images/notion/list.png"/><text class="grow">待确认重点居民</text><text class="task-count">{{summary.screening}}</text><image class="chevron" src="/images/notion/chevron.png"/></view><view class="task-row" bindtap="navigate" data-page="outreach" hover-class="block-hover"><image class="line-icon" src="/images/notion/outreach.png"/><text class="grow">待录入专家意见的名单</text><text class="task-count">{{summary.rosters}}</text><image class="chevron" src="/images/notion/chevron.png"/></view></view>
  <view class="meta">待筛选人数按参考条件统计；新病历归档后重新核对。</view>
  <view class="section-title section">功能入口</view>
  <view class="directory"><view class="directory-row" bindtap="navigate" data-page="residents" hover-class="block-hover"><image class="line-icon" src="/images/notion/folder.png"/><view class="grow"><view class="directory-title">居民健康档案</view><view class="small">历次就诊记录与转诊资料</view></view><image class="chevron" src="/images/notion/chevron.png"/></view><view class="directory-row" bindtap="navigate" data-page="priority" hover-class="block-hover"><image class="line-icon" src="/images/notion/list.png"/><view class="grow"><view class="directory-title">重点居民筛选</view><view class="small">设置条件，人工确认接诊名单</view></view><image class="chevron" src="/images/notion/chevron.png"/></view><view class="directory-row" bindtap="navigate" data-page="outreach" hover-class="block-hover"><image class="line-icon" src="/images/notion/outreach.png"/><view class="grow"><view class="directory-title">专家诊疗记录</view><view class="small">记录专家意见，接续居民档案</view></view><image class="chevron" src="/images/notion/chevron.png"/></view><view class="directory-row" bindtap="navigate" data-page="stats" hover-class="block-hover"><image class="line-icon" src="/images/notion/chart.png"/><view class="grow"><view class="directory-title">服务统计</view><view class="small">各村服务台账与接诊安排参考</view></view><image class="chevron" src="/images/notion/chevron.png"/></view></view>
  <view class="between section"><text class="section-title">待核对草稿</text><text class="small">{{summary.drafts.length}} 份</text></view>
  <view class="draft-sheet"><view wx:if="{{!summary.drafts.length}}" class="empty">暂无待核对草稿。<view class="small">接诊记录可先保存，核实后再归档。</view></view><view wx:for="{{summary.drafts}}" wx:key="_id" class="tap-row between" bindtap="editDraft" data-id="{{item._id}}" hover-class="block-hover"><view class="grow"><view class="patient-name">{{item.patient.name || '居民'}} <text class="badge warn">待核对</text></view><view class="meta">{{item.visitDate}} · {{item.chiefComplaint || '主诉待补充'}}</view></view><image class="chevron" src="/images/notion/chevron.png"/></view></view>
  <view class="archive-strip"><text>建档 {{summary.residents}} 人</text><text>归档 {{summary.archived}} 份</text></view></block><view class="document-footer"><text class="small">病历由接诊医师核对确认</text><text class="link small" bindtap="logout">{{demo ? '退出演示' : '退出账号'}}</text></view><button wx:if="{{demo}}" class="outline" bindtap="reset">重置演示数据</button>
 </block>
</view>
