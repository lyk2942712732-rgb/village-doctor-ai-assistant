.clinic-banner{padding:8rpx 0 32rpx;border-bottom:1rpx solid #e7e5e0;margin-bottom:28rpx}.clinic-banner .title{font-size:46rpx;margin:16rpx 0}.clinic-info{border-top:1rpx solid #dedcd6;padding-top:28rpx;margin-top:42rpx}.clinic-info .meta{margin-bottom:20rpx}.clinic-info .card{margin-top:24rpx}.invite-code{font-size:27rpx;word-break:break-all;color:#37352f;padding:24rpx 0}.member-actions{display:flex;gap:16rpx;margin-top:20rpx}.member-actions button{margin:0;font-size:25rpx;padding:16rpx 18rpx;flex:1}.invite-options{display:flex;gap:24rpx}.invite-options .field{flex:1;min-width:0}.clinic-page input{padding:0 20rpx}.member-row{padding:24rpx 0;border-bottom:1rpx solid #e7e5e0}.member-row:last-child{border:0}.clinic-page .notice button{margin-top:16rpx}.clinic-page>.outline{margin-bottom:28rpx}.clinic-page .card>.section-title{margin-bottom:24rpx}

.performance-grid{display:flex;flex-wrap:wrap;gap:18rpx 0;margin:24rpx 0;font-size:22rpx;color:#706f6b}.performance-grid>view{width:33.333%;text-align:center}.performance-grid text{font-size:34rpx;font-weight:500;color:#37352f}.clinic-page .select{padding:20rpx 12rpx;background:#fff;border:1rpx solid #dedcd6;border-radius:6rpx;font-size:26rpx}.clinic-banner .badge{margin-top:18rpx}

.region-block{border-top:1rpx solid #e9e9e7;border-bottom:1rpx solid #e9e9e7;margin:28rpx 0;padding:24rpx 0}.region-arrow{float:right;color:#9b9a97}.muted{color:#9b9a97}.village-option{display:flex;align-items:center;gap:14rpx;padding:12rpx 0;font-size:27rpx}
