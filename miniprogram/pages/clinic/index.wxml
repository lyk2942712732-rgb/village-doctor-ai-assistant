<view class="page clinic-page">
 <view class="clinic-banner"><image class="page-symbol" src="/images/notion/clinic.png"/><view class="title">{{creating ? '创建卫生室' : (showDetail ? clinic.name : '我的卫生室')}}</view><view class="small">{{showDetail ? '当前工作卫生室 · 档案与接诊数据归属于本室' : '账号可加入多个卫生室，接诊前选择当前工作的卫生室'}}</view><text wx:if="{{showDetail}}" class="badge">{{isAdmin ? '卫生室负责人' : '卫生室医师'}}</text></view>
 <view wx:if="{{error}}" class="error">{{error}}</view>
 <block wx:if="{{!creating && !showDetail}}">
  <view class="card"><view class="section-title">我的医师姓名</view><view class="meta">病历归档使用此姓名；修改不会覆盖旧病历署名。</view><view class="spacer"></view><input value="{{doctorName}}" data-key="doctorName" bindinput="meta" maxlength="40" placeholder="填写接诊医师姓名"/><view class="spacer"></view><button class="outline" bindtap="rename" disabled="{{busy}}">保存姓名</button></view>
  <view class="between section"><text class="section-title">已加入的卫生室</text><text class="small">{{clinics.length}} 个</text></view>
  <view wx:if="{{!clinics.length}}" class="empty">尚未加入卫生室。<view>使用邀请码加入，或自行创建卫生室后即可接诊。</view></view>
  <view class="card" wx:for="{{clinics}}" wx:key="_id" bindtap="open" data-id="{{item._id}}" hover-class="block-hover"><view class="between"><text class="section-title grow">{{item.name}}</text><text class="badge">{{item.role === 'admin' ? '负责人' : '医师'}}</text></view><view class="meta">{{item.county}} {{item.township}}</view><view class="divider"></view><view class="between"><text class="small">{{item.selected ? '当前工作卫生室' : '切换到本卫生室'}}</text><text class="link">打开 / 管理</text></view></view>
  <view class="card"><view class="section-title">加入卫生室</view><view class="meta">向卫生室负责人获取邀请码。</view><view class="spacer"></view><input value="{{joinCode}}" data-key="joinCode" bindinput="meta" maxlength="64" password placeholder="填写卫生室邀请码"/><view class="spacer"></view><button class="primary" bindtap="join" disabled="{{busy}}">加入卫生室</button></view>
  <button class="outline" bindtap="newClinic" disabled="{{busy}}">创建新卫生室</button>
 </block>
 <block wx:if="{{creating || showDetail}}">
  <view class="link section" bindtap="back">返回我的卫生室列表</view>
  <view class="card"><view class="section-title">卫生室资料</view><view wx:if="{{creating}}" class="field"><view class="label">负责人姓名 *</view><input value="{{doctorName}}" data-key="doctorName" bindinput="meta" maxlength="40" placeholder="填写你的姓名"/></view>
   <view class="field"><view class="label">卫生室名称 *</view><input value="{{form.name}}" data-key="name" bindinput="input" disabled="{{!creating && !isAdmin}}" maxlength="80" placeholder="如：幸福村卫生室"/></view>
   <view class="region-block"><view class="label">所在地区 *</view><view class="meta">从省份逐级选择到村 / 社区</view><view wx:if="{{showDetail && (!form.regionCodes || form.regionCodes.length !== 5)}}" class="notice">旧资料尚未选择完整地区，请从省份重新选择后保存。</view><view class="field" wx:for="{{regionFields}}" wx:for-index="level" wx:key="key"><view class="label">{{item.label}}</view><picker mode="selector" range="{{regionOptions[level]}}" range-key="name" value="{{regionIndexes[level]}}" data-level="{{level}}" bindchange="regionChange" disabled="{{regionLoading || (!creating && !isAdmin) || !regionOptions[level].length}}"><view class="select {{!form[item.key] ? 'muted' : ''}}">{{form[item.key] || (regionLoading ? '加载地区…' : (level > 0 && !form[regionFields[level-1].key] ? '请先选择上一级' : '请选择'))}}<text class="region-arrow">⌄</text></view></picker></view></view>
   <view class="field" wx:for="{{fields}}" wx:key="key"><view class="label">{{item.label}}</view><input value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" disabled="{{!creating && !isAdmin}}" maxlength="{{item.max}}" placeholder="{{item.placeholder}}"/></view>
   <view class="field"><view class="label">服务村庄</view><view class="meta">在所选乡镇范围内勾选；未勾选时以卫生室所在村为准。</view><checkbox-group bindchange="servicesChange"><label class="village-option" wx:for="{{serviceOptions}}" wx:key="code"><checkbox value="{{item.code}}" checked="{{item.checked}}" disabled="{{!creating && !isAdmin}}" color="#37352f"/><text>{{item.name}}</text></label></checkbox-group><view wx:if="{{!serviceOptions.length}}" class="meta">{{form.serviceVillages || '选择乡镇后显示可服务的村 / 社区'}}</view></view>
   <button wx:if="{{creating || isAdmin}}" class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy || regionLoading}}">{{creating ? '创建卫生室' : '保存卫生室资料'}}</button><view wx:else class="meta">卫生室资料由负责人维护。</view>
  </view>
 </block>
 <block wx:if="{{showDetail}}">
  <view class="between clinic-info"><text class="section-title">成员绩效 / 工作量</text><text class="small">{{memberCount}} 位成员</text></view>
  <view class="card"><view class="two"><view class="field"><view class="label">开始日期</view><picker mode="date" value="{{performanceRange.start}}" data-key="start" bindchange="date"><view class="select">{{performanceRange.start}}</view></picker></view><view class="field"><view class="label">结束日期</view><picker mode="date" value="{{performanceRange.end}}" data-key="end" bindchange="date"><view class="select">{{performanceRange.end}}</view></picker></view></view><button class="outline" bindtap="load" disabled="{{busy}}">查看成员工作量</button><view class="meta">按归档及生成时间统计当前成员的工作量，居民人数去重；不作为医疗质量评分。</view></view>
  <view class="card"><view class="member-row" wx:for="{{members}}" wx:key="id"><view class="between"><text class="patient-name">{{item.name}}</text><text class="badge">{{item.role === 'admin' ? '负责人' : '医师'}}</text></view><view class="performance-grid"><view><text>{{item.performance.records}}</text><view>归档病历</view></view><view><text>{{item.performance.patients}}</text><view>接诊居民</view></view><view><text>{{item.performance.referrals}}</text><view>转诊资料包</view></view><view><text>{{item.performance.expertNotes}}</text><view>专家意见记录</view></view><view><text>{{item.performance.followups}}</text><view>其中随访记录</view></view></view><view wx:if="{{isAdmin && item.role !== 'admin'}}" class="member-actions"><button class="danger" bindtap="member" data-id="{{item.id}}" disabled="{{busy}}">移除成员</button><button bindtap="transfer" data-id="{{item.id}}" disabled="{{busy}}">移交负责人</button></view></view></view>
  <view wx:if="{{isAdmin}}" class="clinic-info"><view class="section-title">邀请医师加入</view><view class="card"><view class="invite-options"><view class="field"><view class="label">有效期（天，1–30）</view><input type="number" value="{{inviteDays}}" data-key="inviteDays" bindinput="meta"/></view><view class="field"><view class="label">最多加入人数（1–100）</view><input type="number" value="{{inviteUses}}" data-key="inviteUses" bindinput="meta"/></view></view><button class="primary" bindtap="invite" disabled="{{busy}}">生成邀请码</button><view wx:if="{{latestInvite}}" class="notice"><view>请现在复制，离开页面后不再显示完整邀请码。</view><view class="invite-code">{{latestInvite.code}}</view><button class="outline" bindtap="copyInvite">复制邀请码</button></view></view><view class="card"><view wx:if="{{!invites.length}}" class="empty">还没有邀请码</view><view class="member-row" wx:for="{{invites}}" wx:key="id"><view class="between"><text>{{item.hint}}</text><text class="badge">{{item.state}}</text></view><view class="meta">已加入 {{item.used}} / {{item.maxUses}} 人 · 到期 {{item.expiry}}</view><button wx:if="{{item.enabled}}" class="outline" data-id="{{item.id}}" bindtap="revoke" disabled="{{busy}}">停用此邀请码</button></view></view></view>
  <button wx:if="{{!isAdmin}}" class="danger section" bindtap="leave" disabled="{{busy}}">退出本卫生室</button><button wx:if="{{isAdmin}}" class="danger section" bindtap="dissolve" disabled="{{busy}}">解散本卫生室</button>
 </block>
 <button class="outline section" bindtap="home">回到工作台</button>
</view>
