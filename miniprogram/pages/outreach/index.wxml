<view class="page outreach-page">
 <block wx:if="{{!roster}}"><view class="between section"><text class="section-title">已确认接诊名单</text><text class="small">{{rosters.length}} 份</text></view><view class="roster-row" wx:for="{{rosters}}" wx:key="_id" bindtap="choose" data-id="{{item._id}}" hover-class="block-hover"><view class="between"><view class="section-title">{{item.title}}</view><text class="badge">{{item.patients.length}} 人</text></view><view class="meta">计划接诊 {{item.serviceDate}}</view><view class="divider"></view><text class="link">打开接诊名单</text></view><view class="empty" wx:if="{{!rosters.length && !busy}}"><view>暂无已确认的专家接诊名单</view><view>先筛选重点人员，确认本次接诊安排</view></view><button class="primary" bindtap="priority">前往重点居民筛选</button></block>
 <block wx:else><text class="link" bindtap="back">返回接诊名单列表</text><view class="section"><view class="section-title">{{roster.title}}</view><view class="small">{{roster.serviceDate}} · {{roster.patients.length}} 位居民</view></view><view class="card row patient-row {{patient._id === item._id ? 'selected-row' : ''}}" wx:for="{{roster.patients}}" wx:key="_id" bindtap="choosePatient" data-id="{{item._id}}" hover-class="block-hover"><view class="avatar">{{item.name[0]}}</view><view class="grow"><view class="patient-name">{{item.name}}</view><view class="meta">{{item.village}} · {{item.code}}</view></view><text class="badge {{item.done ? '' : 'warn'}}">{{item.done ? '已归档' : '待录入意见'}}</text></view>
 <view class="card" wx:if="{{patient}}"><view class="section-title">为 {{patient.name}} 记录专家意见</view><view class="small">居民编号 {{patient.code}} · {{patient.village}}</view><view class="divider"></view><view class="two"><view class="field"><view class="label">专家姓名 <text class="required">*</text></view><input value="{{form.expertName}}" data-key="expertName" bindinput="input" maxlength="40" placeholder="本次接诊专家"/></view><view class="field"><view class="label">专家科别</view><input value="{{form.specialty}}" data-key="specialty" bindinput="input" maxlength="60" placeholder="如 全科 / 内科"/></view></view><view class="two"><view class="field"><view class="label">服务日期</view><picker mode="date" value="{{form.serviceDate}}" data-key="serviceDate" bindchange="input"><view class="select">{{form.serviceDate}}</view></picker></view><view class="field"><view class="label">服务类型</view><picker range="{{types}}" bindchange="type"><view class="select">{{form.type}}</view></picker></view></view><view class="field"><view class="label">专家诊疗意见 <text class="required">*</text></view><textarea value="{{form.opinion}}" data-key="opinion" bindinput="input" maxlength="6000" auto-height placeholder="按专家原意记录诊疗结论、处理意见及转诊建议"/></view><view class="field"><view class="label">随访与后续安排</view><textarea value="{{form.followup}}" data-key="followup" bindinput="input" maxlength="2000" auto-height placeholder="记录复诊时间、随访事项和责任人"/></view><view class="notice info">保存后关联居民档案，并计入对应村的专家服务台账。</view><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">核对并归档专家意见</button></view></block></view>
