.record-page{padding-bottom:220rpx}.select{background:#fff;border:1rpx solid #dedcd6;border-radius:6rpx;padding:20rpx;font-size:28rpx;min-height:88rpx}.raw-input{min-height:260rpx}.recorder{text-align:left;padding:28rpx 0 30rpx}.record-dot{width:18rpx;height:18rpx;background:#a8a59b;border-radius:3rpx;margin-bottom:16rpx}.record-dot.on{background:#b6433c}.consent{background:#f7f6f3;padding:16rpx;border-radius:6rpx}.field textarea{min-height:150rpx}.ai-toolbar{margin-bottom:32rpx;border-bottom:1rpx solid #e7e5e0;padding-bottom:28rpx}.ai-fill-trigger{display:flex;align-items:center;justify-content:center;gap:14rpx;background:#efedea;border-color:#e1dfd8}.ai-fill-trigger image{width:34rpx;height:34rpx}.ai-hint{margin-top:16rpx}.ai-note{font-size:26rpx;color:#76582e;background:#f3eee5;padding:18rpx 20rpx;border-radius:6rpx;margin-bottom:28rpx}.clinical-field{padding-bottom:28rpx;border-bottom:1rpx solid #e7e5e0;margin-bottom:28rpx}.clinical-field:last-child{border:0;padding-bottom:0;margin-bottom:0}.clinical-field textarea.has-difference{border-color:#b6433c}.ai-candidate{margin-top:18rpx;padding:20rpx;background:#f7f6f3;border-left:3rpx solid #b8b5ac;border-radius:4rpx}.candidate-difference{border-left-color:#b6433c}.ai-label{font-size:24rpx;font-weight:500;color:#57564f}.difference-label{font-size:23rpx;color:#a43b36}.candidate-text,.current-comparison{white-space:pre-wrap;overflow-wrap:break-word;font-size:28rpx;line-height:1.8;margin-top:14rpx}.current-comparison{color:#706f6b;padding-bottom:14rpx;border-bottom:1rpx solid #e7e5e0}.difference-text{color:#a43b36;font-weight:600;background:#f9e5e3}.candidate-empty{margin-top:14rpx}.adopt-ai{font-size:26rpx;padding:16rpx 20rpx;margin-top:20rpx;width:auto;display:inline-block;min-width:210rpx;background:#fff}.clinical-form>.ai-toolbar .small{font-size:25rpx}
