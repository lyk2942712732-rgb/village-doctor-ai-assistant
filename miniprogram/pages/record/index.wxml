<view class="page record-page">
 <view class="header"><image class="page-symbol" src="/images/notion/record.png"/><view class="title">记录本次接诊</view><view class="subtitle">手动记录或逐项采用AI填写，核实后归档。</view></view>
 <view wx:if="{{demo}}" class="notice"><view>当前为演示模式，使用手动录入体验。</view><view class="small">录音转写、AI 和文档导出需要云端账号。</view><button class="outline" bindtap="cloudLogin" disabled="{{busy}}">切换云端登录</button></view>
 <view wx:if="{{error}}" class="error">{{error}}</view>
 <view class="card"><view class="between"><text class="section-title">居民基本信息</text><text class="badge">身份核对</text></view><view class="spacer"></view><picker range="{{residentLabels}}" bindchange="pickPatient"><view class="select">从已建档居民中选择</view></picker><view class="spacer"></view>
 <view class="two"><view class="field"><view class="label">姓名 <text class="required">*</text></view><input value="{{patient.name}}" data-group="patient" data-key="name" bindinput="input" placeholder="居民姓名"/></view><view class="field"><view class="label">居民编号 <text class="required">*</text></view><input value="{{patient.code}}" data-group="patient" data-key="code" bindinput="input" placeholder="如 HLJ001"/></view></view>
 <view class="two"><view class="field"><view class="label">性别</view><picker range="{{sexes}}" bindchange="pickSex"><view class="select">{{patient.sex}}</view></picker></view><view class="field"><view class="label">出生日期</view><picker mode="date" value="{{patient.birthDate}}" data-group="patient" data-key="birthDate" bindchange="changeDate"><view class="select">{{patient.birthDate || '选择出生日期'}}</view></picker></view></view>
 <view class="two"><view class="field"><view class="label">所属村 <text class="required">*</text></view><input value="{{patient.village}}" data-group="patient" data-key="village" bindinput="input" placeholder="如 幸福村"/></view><view class="field"><view class="label">联系电话（可选）</view><input value="{{patient.phone}}" type="number" data-group="patient" data-key="phone" bindinput="input" placeholder="本人或家属手机号"/></view></view>
 <view class="label">就诊日期</view><picker mode="date" value="{{form.visitDate}}" data-group="form" data-key="visitDate" bindchange="changeDate"><view class="select">{{form.visitDate}}</view></picker></view>
 <view class="card"><view class="section-title">医患沟通记录</view><view class="chips section"><view class="chip {{mode === 'manual' ? 'active' : ''}}" data-mode="manual" bindtap="mode" hover-class="block-hover">文字记录</view><view class="chip {{mode === 'voice' ? 'active' : ''}}" data-mode="voice" bindtap="mode" hover-class="block-hover">录音转写</view></view>
 <block wx:if="{{mode === 'voice'}}"><view class="between consent"><text class="small">已征得居民同意录音及转写</text><switch checked="{{consent}}" data-key="consent" bindchange="toggle" color="#37352f"/></view><view class="recorder"><view class="record-dot {{recording ? 'on' : ''}}"></view><view class="section-title">{{recording ? '正在录音' : '录下本次问诊'}}</view><view class="small">{{recording ? seconds + ' 秒 · 最长 10 分钟' : '录音完成后上传识别，可核对转写原文'}}</view></view><view class="actions"><button wx:if="{{!recording}}" bindtap="startRecord" disabled="{{demo || busy || taskId}}" class="primary">开始录音</button><button wx:else bindtap="stopRecord" class="danger">结束录音</button><button bindtap="transcribe" disabled="{{demo || !audioPath || busy || recording || taskId}}" loading="{{busy}}">上传并转写</button></view><view class="meta">{{asrStatus}}</view><button wx:if="{{taskId}}" class="outline" bindtap="resumeAsr" disabled="{{polling}}" loading="{{polling}}">继续查询转写</button><view wx:if="{{transcript}}" class="field"><view class="label">核对转写结果</view><textarea value="{{transcript}}" bindinput="editTranscript" auto-height maxlength="12000"/><button class="outline" bindtap="useTranscript" disabled="{{busy}}">用于本次沟通记录</button></view><view class="divider"></view></block>
 <textarea class="raw-input" value="{{form.rawText}}" data-key="rawText" bindinput="input" maxlength="12000" auto-height placeholder="输入医患对话或就诊信息。也可使用“主诉：…”“既往史：…”等标签，便于按模板整理。"/>
 <view class="between meta"><text>原文会随病历保留</text><text>{{form.rawText.length}} / 12000</text></view></view>
 <view class="between section"><text class="section-title">病历内容</text><text class="small">手动填写 / AI填写</text></view>
 <view class="card clinical-form">
  <view class="ai-toolbar"><button class="outline ai-fill-trigger" bindtap="generate" loading="{{busy}}" disabled="{{demo || busy || recording}}"><image src="/images/notion/spark.png"/><text>AI填写</text></button><view class="small ai-hint">可直接手动填写，也可让AI根据沟通记录提供候选内容，再逐项选择采用。</view></view>
  <view wx:if="{{aiValues}}" class="ai-note">AI可能出错。红色标出与当前填写不同的文字，请核实是否冲突；未采用的内容不会存入病历。</view>
  <view class="field clinical-field" wx:for="{{fields}}" wx:key="key" wx:for-index="fieldIndex">
   <view class="label">{{item.key === 'diagnosis' ? '诊断' : item.label}}</view>
   <textarea class="{{aiCandidates[fieldIndex].different ? 'has-difference' : ''}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" auto-height maxlength="2000" placeholder="可直接手动填写；尚未取得的信息请明确说明"/>
   <view wx:if="{{aiValues}}" class="ai-candidate {{aiCandidates[fieldIndex].different ? 'candidate-difference' : ''}}">
    <view class="between"><text class="ai-label">AI建议内容</text><text wx:if="{{aiCandidates[fieldIndex].different}}" class="difference-label">与当前填写有差异</text></view>
    <view wx:if="{{aiCandidates[fieldIndex].different}}" class="current-comparison"><text class="small">当前填写对照：</text><text wx:for="{{aiCandidates[fieldIndex].currentParts}}" wx:for-item="part" wx:key="id" class="{{part.changed ? 'difference-text' : ''}}">{{part.text}}</text></view>
    <view wx:if="{{aiCandidates[fieldIndex].text}}" class="candidate-text"><text wx:for="{{aiCandidates[fieldIndex].parts}}" wx:for-item="part" wx:key="id" class="{{part.changed ? 'difference-text' : ''}}">{{part.text}}</text></view>
    <view wx:else class="small candidate-empty">沟通记录中未提取到本项内容，请按实际情况手动填写。</view>
    <button wx:if="{{aiCandidates[fieldIndex].text}}" class="outline adopt-ai" data-key="{{item.key}}" bindtap="adoptAi" disabled="{{busy || aiCandidates[fieldIndex].same}}">{{aiCandidates[fieldIndex].same ? '与当前填写一致' : '采用AI填写'}}</button>
   </view>
  </view>
 </view>
 <view class="card"><view class="section-title">随访与接诊安排</view><view class="small">以下标记由接诊医师判断，用于筛选接诊名单</view><view class="spacer"></view><view class="two"><view class="field"><view class="label">已确认的疾病种类数</view><input value="{{form.chronicCount}}" type="number" data-key="chronicCount" bindinput="input"/></view><view class="field"><view class="label">接诊优先级</view><picker range="{{urgencies}}" bindchange="pickUrgency"><view class="select">{{form.urgency}}</view></picker></view></view><view class="between field"><text>存在需复核的异常指标</text><switch checked="{{form.abnormal}}" data-key="form.abnormal" bindchange="toggle" color="#37352f"/></view><view wx:if="{{form.abnormal}}" class="field"><textarea value="{{form.abnormalNote}}" data-key="abnormalNote" bindinput="input" placeholder="说明指标、数值、单位和核查情况" maxlength="600" auto-height/></view><view class="between field"><text>需要准备转诊资料</text><switch checked="{{form.referralNeeded}}" data-key="form.referralNeeded" bindchange="toggle" color="#37352f"/></view><view class="label">计划复诊日期（可选）</view><picker mode="date" value="{{form.followupDate}}" data-group="form" data-key="followupDate" bindchange="changeDate"><view class="select">{{form.followupDate || '选择复诊日期'}}</view></picker><view class="divider"></view><view class="between"><text class="small">我已核对居民身份及全部病历内容</text><switch checked="{{reviewConfirmed}}" data-key="reviewConfirmed" bindchange="toggle" color="#37352f"/></view></view>
 <view class="sticky actions"><button class="outline" bindtap="saveDraft" disabled="{{busy || recording}}">保存草稿</button><button class="primary" bindtap="archive" disabled="{{busy || !reviewConfirmed || recording}}" loading="{{busy}}">确认并归档</button></view>
</view>
