.search-row{align-items:stretch}.search-row input{flex:1;min-width:0}.search-row button{flex-shrink:0;padding-left:24rpx;padding-right:24rpx}.list-head{display:flex;justify-content:space-between;border-top:1rpx solid #dedcd6;border-bottom:1rpx solid #dedcd6;padding:14rpx 4rpx;color:#706f6b;font-size:24rpx}.resident-row{padding:28rpx 4rpx;border-bottom:1rpx solid #e7e5e0}.record-count{text-align:right;color:#37352f;font-size:32rpx;font-weight:500;min-width:80rpx}.identity{background:#fff;border:1rpx solid #e7e5e0;border-radius:6rpx;padding:28rpx}.identity .title{font-size:44rpx}.identity .avatar{background:#efedea}.identity .row{flex-wrap:wrap}.timeline-card{position:relative;background:#fff;padding:26rpx;margin:0 0 24rpx;border:1rpx solid #e7e5e0;border-left:3rpx solid #a8a59b;border-radius:4rpx}.history-field{margin-bottom:28rpx;font-size:28rpx}.history-field .label{color:#706f6b;font-size:24rpx}.history-field .pre{line-height:1.85}
