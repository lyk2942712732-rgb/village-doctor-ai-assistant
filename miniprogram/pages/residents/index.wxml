<view class="page residents-page">
 <view class="header"><image class="page-symbol" src="/images/notion/folder.png"/><view class="title">居民健康档案</view><view class="subtitle">查询历次就诊记录，导出转诊资料。</view></view><view wx:if="{{error}}" class="error">{{error}}</view>
 <block wx:if="{{!detail}}"><view class="row search-row"><input value="{{query}}" bindinput="input" bindconfirm="search" confirm-type="search" placeholder="搜索居民姓名或居民编号"/><button class="primary" bindtap="search" loading="{{busy}}" disabled="{{busy}}">查询</button></view><view class="between section"><text class="section-title">居民档案</text><text class="small">{{people.length}} 人</text></view><view class="list-head" wx:if="{{people.length}}"><text>居民 / 编号</text><text>就诊记录</text></view><view class="empty" wx:if="{{!people.length && !busy}}"><view>没有找到居民档案</view><view>完成首次病历录入后将自动建档</view></view><view class="resident-row row" wx:for="{{people}}" wx:key="_id" bindtap="patient" data-id="{{item._id}}" hover-class="block-hover"><view class="avatar">{{item.name[0]}}</view><view class="grow"><view class="patient-name">{{item.name}} <text class="small">{{item.sex}} · {{item.age}} 岁</text></view><view class="meta">{{item.code}} · {{item.village}}</view></view><view class="record-count"><view>{{item.count}}</view><text class="small">次就诊</text></view></view></block>
 <block wx:else><view class="link" bindtap="back" hover-class="block-hover">返回居民列表</view><view class="spacer"></view><view class="identity"><view class="row"><view class="avatar">{{detail.name[0]}}</view><view class="grow"><view class="title">{{detail.name}}</view><view>{{detail.sex}} · {{detail.age}} 岁 · {{detail.village}}</view></view><text class="badge">{{detail.code}}</text></view><view class="divider"></view><view class="small"><view>出生日期 {{detail.birthDate}}</view><view>联系电话 {{detail.phone || '未提供'}}</view></view><view class="spacer"></view><button class="outline" bindtap="add">为这位居民录入新病历</button></view>
 <view class="between section"><text class="section-title">历次就诊 · {{records.length}}</text><text class="link" bindtap="all">{{selectedCount === records.length ? '取消全选' : '选择全部'}}</text></view><view class="empty" wx:if="{{!records.length}}">尚无正式归档的就诊病历</view>
 <view class="timeline-card" wx:for="{{records}}" wx:key="_id" wx:for-item="record"><view class="between"><view class="row grow"><view class="check {{record.selected ? 'checked' : ''}}" bindtap="select" data-id="{{record._id}}" hover-class="block-hover">✓</view><view class="grow" bindtap="expand" data-id="{{record._id}}" hover-class="block-hover"><view class="small">{{record.visitDate}} · {{record.doctorName}}</view><view class="patient-name">{{record.chiefComplaint}}</view></view></view><text class="link" bindtap="expand" data-id="{{record._id}}">{{opened === record._id ? '收起' : '详情'}}</text></view><view class="meta">诊断：{{record.diagnosis}}</view>
 <block wx:if="{{opened === record._id}}"><view class="divider"></view><view wx:for="{{fields}}" wx:key="key" wx:for-item="field" class="history-field"><view class="label">{{field.key === 'diagnosis' ? '诊断' : field.label}}</view><view class="pre">{{record[field.key] || '未记录'}}</view></view><view class="history-field"><view class="label">原始沟通记录</view><view class="small pre">{{record.rawText || '无原文'}}</view></view><view class="small">记录方式 {{record.engine || '村医录入'}} · 审核医师 {{record.doctorName}}</view></block></view>
 <view class="section-title section">专家专家诊疗记录 · {{services.length}}</view><view class="card" wx:for="{{services}}" wx:key="_id"><view class="between"><text class="patient-name">{{item.expertName}}</text><text class="badge">{{item.type}}</text></view><view class="meta">{{item.serviceDate}} · {{item.specialty || '未填写科别'}}</view><view class="divider"></view><view class="pre">{{item.opinion}}</view><view class="meta">随访计划：{{item.followup || '未填写'}}</view></view><view class="empty" wx:if="{{!services.length}}">暂无专家诊疗记录</view>
 <view class="notice">转诊包包含所选正式病历、居民基本信息及全部专家服务记录。生成后可在文档菜单保存、分享或打印。</view><button class="primary" bindtap="export" loading="{{busy}}" disabled="{{busy || !selectedCount}}">导出 PDF 转诊包（{{selectedCount}} 份病历）</button></block>
</view>
