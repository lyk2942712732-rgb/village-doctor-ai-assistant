.select{background:#fff;padding:20rpx 12rpx;border:1rpx solid #dedcd6;border-radius:6rpx;text-align:center;min-height:88rpx}.capacity input{width:112rpx;text-align:center;height:80rpx}.ledger-summary{border-top:1rpx solid #dedcd6;border-bottom:1rpx solid #dedcd6}.ledger-row{display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #e7e5e0;padding:18rpx 4rpx;font-size:26rpx}.ledger-row:last-child{border-bottom:0}.ledger-number{font-size:34rpx;font-weight:500;font-variant-numeric:tabular-nums}.village-sheet{padding:28rpx 0;border-top:1rpx solid #dedcd6;border-bottom:1rpx solid #dedcd6;margin-bottom:24rpx}.village-numbers{display:flex;margin:26rpx 0;font-size:24rpx;color:#706f6b;text-align:center}.village-numbers>view{flex:1;border-right:1rpx solid #e7e5e0}.village-numbers>view:last-child{border:0}.village-numbers text{font-size:36rpx;font-weight:500;color:#37352f}.village-sheet .label{margin-bottom:4rpx}
