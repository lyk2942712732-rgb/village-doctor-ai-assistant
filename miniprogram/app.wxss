page{background:#f7f6f3;color:#37352f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.65}
view,text,input,textarea,button{box-sizing:border-box}button::after{border:0}
button{min-height:88rpx;margin:0;padding:20rpx 24rpx;border:1rpx solid #e7e5e0;border-radius:8rpx;background:#fff;color:#37352f;font-size:28rpx;font-weight:500;line-height:1.6;transition:background-color .15s}
button[disabled]{opacity:.48;color:#706f6b}.button-hover,.button-pressed,.block-hover{background:#e3e1db!important}.block-hover{border-radius:6rpx}
input,textarea{width:100%;background:#fff;border:1rpx solid #dedcd6;border-radius:6rpx;color:#37352f;font-size:28rpx}input{height:88rpx;padding:0 20rpx}textarea{min-height:160rpx;padding:18rpx 20rpx;line-height:1.8}input[disabled],textarea[disabled]{background:#f7f6f3;color:#706f6b}
.page{padding:32rpx 36rpx 190rpx}.header{margin-bottom:38rpx}.page-symbol{display:block;width:68rpx;height:68rpx;margin-bottom:20rpx}.title{font-size:52rpx;font-weight:650;letter-spacing:-1rpx;line-height:1.3;overflow-wrap:break-word}.subtitle{font-size:26rpx;color:#706f6b;margin-top:16rpx;line-height:1.7}.section-title{font-size:32rpx;font-weight:600;line-height:1.5}.small,.muted{font-size:24rpx;color:#706f6b}.meta{font-size:24rpx;color:#706f6b;margin-top:8rpx;line-height:1.7}
.row{display:flex;align-items:center;gap:18rpx}.between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.wrap{flex-wrap:wrap}.grow{flex:1;min-width:0}
.card{background:#fff;border:1rpx solid #e7e5e0;border-radius:8rpx;padding:28rpx;margin-bottom:28rpx}.section{margin:42rpx 0 22rpx}.label{font-size:26rpx;font-weight:600;margin-bottom:12rpx}.field{margin-bottom:28rpx}.primary{background:#37352f;color:#fff;border-color:#37352f}.primary.button-hover{background:#54514a!important}.secondary{background:#efedea;color:#37352f;border-color:#efedea}.outline{background:transparent;border-color:#d9d6ce;color:#37352f}.danger{color:#a43b36;background:#fbefed;border-color:#efcfca}
.notice{background:#f3eee5;color:#76582e;font-size:26rpx;padding:20rpx 22rpx;border-radius:6rpx;margin-bottom:26rpx;border-left:3rpx solid #b9a177}.info{background:#eeefed;color:#57574f;border-left-color:#a3a49a}.badge{display:inline-block;font-size:22rpx;font-weight:400;line-height:1.5;padding:4rpx 12rpx;background:#eeedeb;color:#57564f;border-radius:5rpx;flex-shrink:0}.badge.warn{background:#f3eadb;color:#805b2c}.badge.red{background:#f9e5e3;color:#a43b36}.badge.done{background:#e4eee8;color:#36624d}
.actions{display:flex;gap:16rpx}.actions button{flex:1;min-width:0}.divider{height:1rpx;background:#e7e5e0;margin:28rpx 0}.empty{text-align:left;padding:36rpx 0;color:#706f6b;font-size:26rpx;line-height:1.9}.error{background:#fbefed;border-left:3rpx solid #b6433c;color:#923a34;padding:22rpx;border-radius:6rpx;margin-bottom:28rpx;font-size:26rpx;overflow-wrap:break-word}
.metric{font-size:64rpx;font-weight:600;line-height:1.25;font-variant-numeric:tabular-nums}.chips{display:flex;gap:6rpx;flex-wrap:wrap;border-bottom:1rpx solid #e7e5e0;padding-bottom:10rpx}.chip{min-height:80rpx;padding:18rpx 24rpx;border:0;border-radius:6rpx;background:transparent;font-size:26rpx;color:#706f6b}.chip.active{background:#efedea;color:#37352f;font-weight:600}
.avatar{width:70rpx;height:70rpx;border-radius:6rpx;background:#efedea;color:#57564f;border:1rpx solid #e7e5e0;display:flex;align-items:center;justify-content:center;font-size:28rpx;font-weight:500;flex-shrink:0}.patient-name{font-size:32rpx;font-weight:600}.sticky{position:fixed;bottom:0;left:0;right:0;background:#f7f6f3;border-top:1rpx solid #dedcd6;padding:18rpx 36rpx calc(18rpx + env(safe-area-inset-bottom));z-index:10}
.check{width:42rpx;height:42rpx;border:2rpx solid #c7c4bb;border-radius:5rpx;display:flex;align-items:center;justify-content:center;color:transparent;flex-shrink:0}.check.checked{background:#37352f;color:#fff;border-color:#37352f}.pre{white-space:pre-wrap;overflow-wrap:break-word;word-break:break-all}.spacer{height:24rpx}.two{display:flex;gap:22rpx}.two>.field{flex:1;min-width:0}.required{color:#a43b36}.tap-row{padding:26rpx 0;border-bottom:1rpx solid #e7e5e0}.tap-row:last-child{border:0}.link{color:#57564f;font-weight:500;text-decoration:underline;text-underline-offset:5rpx}.pill{font-size:22rpx;background:#eeedeb;padding:4rpx 12rpx;border-radius:5rpx;color:#706f6b}.bar{height:6rpx;border-radius:0;background:#efedea;overflow:hidden}.bar-fill{height:100%;background:#a8a59b}.count{font-variant-numeric:tabular-nums}.line-icon{width:40rpx;height:40rpx;flex-shrink:0}.chevron{width:30rpx;height:30rpx;opacity:.55;flex-shrink:0}

