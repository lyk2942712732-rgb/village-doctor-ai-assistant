.tabbar{position:fixed;bottom:0;left:0;right:0;display:flex;gap:6rpx;background:#f7f6f3;border-top:1rpx solid #dedcd6;padding:12rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));z-index:20}.tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;min-height:94rpx;padding:10rpx 4rpx;color:#706f6b;font-size:22rpx;border-radius:6rpx;line-height:1.6}.tab-icon{height:36rpx;width:36rpx;opacity:.6}.active{color:#37352f;background:#eae8e2;font-weight:600}.active .tab-icon{opacity:1}.tab-pressed{background:#e3e1db}
